# ==============================================================================
# Whack Tutoring AI & LLM Configuration Example Template
# ==============================================================================
# Copy this file to `backend/.env` and add your private API keys.
# NEVER commit the actual `.env` file to version control.

# LLM Provider: "auto", "gemini", "openai", "ollama", or "heuristic"
# - "auto": Uses Gemini if GEMINI_API_KEY is present, else OpenAI, else Heuristic
LLM_PROVIDER=auto

# Google Gemini Configuration (Recommended - Free Tier up to 15 RPM on Google AI Studio)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI Configuration
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local Offline LLM Configuration (if running Ollama locally)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
